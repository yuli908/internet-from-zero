{
  "format": "ifz-l3-vectors/1",
  "note": "M3-G8 参考向量：覆盖 dff / register / counter / shift 四类器件、复位、setup 与 hold 两类违例。逐条比对 tick / Q 值（MSB 在前）/ trace kind（最后一条 L3 观测事件）。期望值按 src/sim 语义与 docs/simulation/ref/simcore/logic.py 推导。",
  "cases": [
    {
      "name": "dff_rise_sample",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "1"], [5, "clk", "1"], [7, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "1", "kind": "SAMPLE"}
      ]
    },
    {
      "name": "dff_fall_ignored",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "1"], [5, "clk", "1"], [7, "clk", "0"], [10, "d", "0"], [15, "clk", "1"], [17, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "1", "kind": "SAMPLE"},
        {"t": 16, "value": "1", "kind": "SAMPLE"},
        {"t": 17, "value": "0", "kind": "SAMPLE"}
      ]
    },
    {
      "name": "dff_reset_priority",
      "kind": "dff",
      "reset": true,
      "events": [[0, "d", "1"], [4, "rst", "1"], [5, "clk", "1"], [7, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "0", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "dff_reset_release",
      "kind": "dff",
      "reset": true,
      "events": [[0, "d", "1"], [4, "rst", "1"], [5, "clk", "1"], [7, "clk", "0"], [8, "rst", "0"], [15, "clk", "1"], [17, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "0", "kind": "SAMPLE"},
        {"t": 17, "value": "1", "kind": "SAMPLE"}
      ]
    },
    {
      "name": "dff_d_unknown",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "X"], [5, "clk", "1"], [7, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "X", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "dff_setup_violation",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "0"], [5, "clk", "1"], [7, "clk", "0"], [14, "d", "1"], [15, "clk", "1"], [17, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "0", "kind": "SAMPLE", "meta": ""},
        {"t": 17, "value": "X", "kind": "METASTABLE", "meta": "setup"}
      ]
    },
    {
      "name": "dff_hold_violation",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "0"], [5, "clk", "1"], [5, "d", "1"], [7, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "X", "kind": "METASTABLE", "meta": "hold"}
      ]
    },
    {
      "name": "dff_hold_boundary",
      "kind": "dff",
      "reset": false,
      "events": [[0, "d", "0"], [5, "clk", "1"], [6, "d", "1"], [7, "clk", "0"]],
      "expects": [
        {"t": 7, "value": "0", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "register_load",
      "kind": "register",
      "width": 4,
      "reset": true,
      "events": [[0, "r.d0", "1"], [0, "r.d1", "1"], [0, "r.d2", "0"], [0, "r.d3", "1"]],
      "clock": {"period": 10, "cycles": 3, "start": 4},
      "expects": [
        {"t": 7, "value": "1011", "kind": "SAMPLE"},
        {"t": 17, "value": "1011", "kind": "SAMPLE"}
      ]
    },
    {
      "name": "register_reset",
      "kind": "register",
      "width": 4,
      "reset": true,
      "events": [[0, "r.d0", "1"], [0, "r.d1", "1"], [0, "r.d2", "0"], [0, "r.d3", "1"], [15, "rst", "1"]],
      "clock": {"period": 10, "cycles": 3, "start": 4},
      "expects": [
        {"t": 7, "value": "1011", "kind": "SAMPLE", "meta": ""},
        {"t": 26, "value": "0000", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "register_en_load",
      "kind": "register",
      "width": 2,
      "reset": true,
      "en": true,
      "events": [[0, "en", "1"], [0, "r.d0", "1"], [8, "r.d0", "0"], [10, "en", "0"]],
      "clock": {"period": 10, "cycles": 2, "start": 6},
      "expects": [
        {"t": 8, "value": "01", "kind": "SAMPLE"},
        {"t": 19, "value": "01", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "register_en_unknown",
      "kind": "register",
      "width": 2,
      "reset": true,
      "en": true,
      "events": [[0, "en", "1"], [0, "r.d0", "1"], [20, "en", "X"], [20, "r.d0", "1"]],
      "clock": {"period": 10, "cycles": 3, "start": 6},
      "expects": [
        {"t": 8, "value": "01", "kind": "SAMPLE"},
        {"t": 29, "value": "XX", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter_count4",
      "kind": "counter",
      "width": 4,
      "reset": true,
      "events": [[0, "rst", "1"], [2, "rst", "0"]],
      "clock": {"period": 20, "cycles": 4, "start": 4},
      "expects": [
        {"t": 19, "value": "0001", "kind": "SAMPLE", "meta": ""},
        {"t": 39, "value": "0010", "kind": "SAMPLE", "meta": ""},
        {"t": 59, "value": "0011", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter_wrap4",
      "kind": "counter",
      "width": 4,
      "reset": true,
      "events": [[0, "rst", "1"], [2, "rst", "0"]],
      "clock": {"period": 20, "cycles": 18, "start": 20},
      "expects": [
        {"t": 39, "value": "0001", "kind": "SAMPLE", "meta": ""},
        {"t": 159, "value": "0111", "kind": "SAMPLE", "meta": ""},
        {"t": 299, "value": "1110", "kind": "SAMPLE", "meta": ""},
        {"t": 319, "value": "1111", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter_load",
      "kind": "counter",
      "width": 4,
      "reset": true,
      "load": true,
      "load_srcs": ["ld0", "ld1", "ld2", "ld3"],
      "events": [[0, "rst", "1"], [2, "rst", "0"], [4, "ld0", "1"], [4, "ld3", "1"], [4, "load", "1"], [34, "load", "0"]],
      "clock": {"period": 20, "cycles": 2, "start": 20},
      "expects": [
        {"t": 39, "value": "1001", "kind": "SAMPLE", "meta": ""},
        {"t": 59, "value": "1010", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter_en_hold",
      "kind": "counter",
      "width": 4,
      "reset": true,
      "en": true,
      "load": true,
      "load_srcs": ["ld0", "ld1", "ld2", "ld3"],
      "events": [[0, "en", "1"], [0, "rst", "1"], [2, "rst", "0"], [4, "ld0", "1"], [4, "ld3", "1"], [4, "load", "1"], [34, "load", "0"], [44, "en", "0"]],
      "clock": {"period": 20, "cycles": 4, "start": 20},
      "expects": [
        {"t": 39, "value": "1001", "kind": "SAMPLE", "meta": ""},
        {"t": 59, "value": "1010", "kind": "SAMPLE", "meta": ""},
        {"t": 99, "value": "1010", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter_too_fast",
      "kind": "counter",
      "width": 4,
      "reset": true,
      "events": [[0, "rst", "1"], [2, "rst", "0"]],
      "clock": {"period": 10, "cycles": 12, "start": 10},
      "expects": [
        {"t": 130, "value": "X*", "kind": "SAMPLE", "meta": "any"}
      ]
    },
    {
      "name": "counter8_count",
      "kind": "counter",
      "width": 8,
      "reset": true,
      "events": [[0, "rst", "1"], [2, "rst", "0"]],
      "clock": {"period": 26, "cycles": 3, "start": 30},
      "expects": [
        {"t": 55, "value": "00000001", "kind": "SAMPLE", "meta": ""},
        {"t": 81, "value": "00000010", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "counter1_bit",
      "kind": "counter",
      "width": 1,
      "reset": false,
      "events": [],
      "clock": {"period": 14, "cycles": 4, "start": 20},
      "expects": [
        {"t": 33, "value": "1", "kind": "SAMPLE", "meta": ""},
        {"t": 47, "value": "0", "kind": "SAMPLE", "meta": ""},
        {"t": 61, "value": "1", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "shift_101",
      "kind": "shift",
      "width": 3,
      "reset": false,
      "events": [[0, "din", "1"], [8, "din", "0"]],
      "clock": {"period": 10, "cycles": 4, "start": 4},
      "expects": [
        {"t": 7, "value": "001", "kind": "SAMPLE", "meta": ""},
        {"t": 17, "value": "010", "kind": "SAMPLE", "meta": ""},
        {"t": 27, "value": "100", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "shift_en_hold",
      "kind": "shift",
      "width": 3,
      "reset": false,
      "en": true,
      "events": [[0, "en", "1"], [0, "din", "1"], [12, "din", "0"], [34, "en", "0"]],
      "clock": {"period": 20, "cycles": 4, "start": 8},
      "expects": [
        {"t": 47, "value": "010", "kind": "SAMPLE", "meta": ""},
        {"t": 88, "value": "010", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "shift_reset",
      "kind": "shift",
      "width": 3,
      "reset": true,
      "events": [[0, "din", "1"], [15, "rst", "1"]],
      "clock": {"period": 10, "cycles": 4, "start": 4},
      "expects": [
        {"t": 16, "value": "011", "kind": "SAMPLE", "meta": ""},
        {"t": 26, "value": "000", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "shift_1011_width4",
      "kind": "shift",
      "width": 4,
      "reset": false,
      "events": [[0, "din", "1"], [10, "din", "0"], [20, "din", "1"], [30, "din", "1"]],
      "clock": {"period": 10, "cycles": 5, "start": 4},
      "expects": [
        {"t": 7, "value": "0001", "kind": "SAMPLE", "meta": ""},
        {"t": 17, "value": "0010", "kind": "SAMPLE", "meta": ""},
        {"t": 27, "value": "0101", "kind": "SAMPLE", "meta": ""},
        {"t": 37, "value": "1011", "kind": "SAMPLE", "meta": ""}
      ]
    },
    {
      "name": "shift_setup_violation",
      "kind": "shift",
      "width": 2,
      "reset": false,
      "events": [[0, "din", "0"], [13, "din", "1"]],
      "clock": {"period": 10, "cycles": 3, "start": 4},
      "expects": [
        {"t": 6, "value": "00", "kind": "SAMPLE", "meta": ""},
        {"t": 16, "value": "0X", "kind": "METASTABLE", "meta": "setup"}
      ]
    }
  ]
}
