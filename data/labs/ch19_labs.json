  "labs": {
    "shared_medium": {
      "id": "shared_medium",
      "title": "共享介质 · 空气是一根共用的线",
      "body": "同一片空气同一时刻只能一个终终端在发；撞了就随机退避，冲突率必须降到 10% 以下。",
      "sections": [
        {
          "order": 1,
          "after": 0,
          "title": "开场 · 空气是一根大家共用的线",
          "text": "无线没有私线：所有终端把信号发进同一片空气，同一时刻只能有一个在发。两个人同时开口，接收端听到的是叠加，不是两句话。"
        },
        {
          "order": 2,
          "after": 0,
          "title": "冲突 · 先听后发，撞了就退避",
          "text": "先听后发、空闲才发；撞上就随机等一段再重试，这叫 CSMA 与退避。等多久必须随机，否则两个终端会一直同步撞下去。"
        },
        {
          "order": 3,
          "after": 1,
          "title": "做一遍 · 多终端同发，统计冲突率",
          "text": "做一遍：接上天线，让多个终端在同一信道同发，记录成功、冲突与重试次数。加上退避后再跑一遍，冲突率必须降到 10% 以下。"
        },
        {
          "order": 4,
          "after": 2,
          "title": "负例 · 退避固定，冲突记成丢包",
          "text": "负例：退避固定等同一段时间，终端永远同步撞；或把冲突记成丢包，冲突率永远是 0。图表好看，介质仍不可用——必须判红。"
        },
        {
          "order": 5,
          "after": 3,
          "title": "验收 · 冲突率 <10%",
          "text": "验收：冲突率 <10%。四条同时——①同一信道确实发生冲突；②退避后冲突率达标；③冲突与重试可查；④W07 天线落袋。只跑单个终端，不给过。"
        }
      ],
      "p1": "多终端同发，统计无退避与有退避两轮的冲突与重试",
      "p1_gates": [
